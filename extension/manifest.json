{
  "manifest_version": 3,
  "name": "千牛趋势提报助手",
  "version": "0.2.4",
  "description": "一键打开千牛商机发现并启动趋势提报。",
  "permissions": [
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/plane-16.png",
      "32": "icons/plane-32.png"
    }
  },
  "icons": {
    "16": "icons/plane-16.png",
    "32": "icons/plane-32.png",
    "48": "icons/plane-48.png",
    "128": "icons/plane-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "run_at": "document_idle",
      "matches": [
        "https://myseller.taobao.com/home.htm/trend-product-operation/*"
      ],
      "js": [
        "trend.js"
      ]
    }
  ]
}
